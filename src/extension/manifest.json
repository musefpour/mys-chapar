{
  "manifest_version": 3,
  "name": "MYs Chapar",
  "version": "0.1.0",
  "description": "MYs Chapar — API client",
  "author": "Mahdi Usefpour",
  "action": {
    "default_title": "Open MYs Chapar",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": ["http://*/*", "https://*/*", "<all_urls>"],
  "permissions": []
}
